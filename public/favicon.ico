      <!-- Car Body -->
      <path d="M -105 12 C -95 5, -85 -2, -70 -8 C -55 -15, -40 -30, -18 -40 C 5 -50, 40 -50, 68 -40 C 90 -32, 102 -20, 118 -12 C 130 -5, 134 2, 136 8 L 58 14 L -28 14 Z" fill="#ffffff"/>
      <circle cx="-54" cy="14" r="13" fill="#060b18" stroke="#d97706" stroke-width="3"/>
      <circle cx="86" cy="14" r="13" fill="#060b18" stroke="#d97706" stroke-width="3"/>
    </g>
  </g>
</svg>
