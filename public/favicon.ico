<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="64" height="64">
  <defs>
    <linearGradient id="amberBg" x1="0%" y1="100%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#b45309"/>
      <stop offset="50%" stop-color="#d97706"/>
      <stop offset="100%" stop-color="#f59e0b"/>
    </linearGradient>
  </defs>
  <!-- Background Dark Circle -->
  <rect width="64" height="64" rx="14" fill="#060b18"/>
  <g transform="translate(32, 32)">
    <g transform="rotate(-21) scale(0.18)">
      <!-- Oval Disk -->
      <ellipse cx="0" cy="-12" rx="145" ry="58" fill="url(#amberBg)"/>
      <!-- Road -->
      <path d="M -155 14 C -130 46, -30 72, 50 64 C 110 58, 155 32, 162 14 C 150 28, 100 46, 44 50 C -35 54, -120 32, -145 4 Z" fill="#091326" stroke="#fbbf24" stroke-width="3"/>
